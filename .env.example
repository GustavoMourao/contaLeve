# ──────────────────────────────────────────────
# contaLeve — environment variables template
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Database (used by docker-compose; change only if you customise docker-compose.yml)
DATABASE_URL=postgresql://contaLeve:contaLeve@db:5432/contaLeve

# ── Email notifications ────────────────────────
# Every new lead captured on the site will trigger an email to ADMIN_EMAIL.
# Uses STARTTLS on SMTP_PORT (default 587).

# Where to send lead notifications (your inbox)
ADMIN_EMAIL=you@example.com

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Login credentials for the sending account
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: display name / address in the From header (defaults to SMTP_USER)
SMTP_FROM=contaLeve Leads <your-sender@gmail.com>

# ── Notes ─────────────────────────────────────
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your
#        regular password. 2FA must be enabled on the account.
# Other providers: adjust SMTP_HOST and SMTP_PORT accordingly.
#   Outlook/Hotmail : smtp-mail.outlook.com  port 587
#   Brevo (Sendinblue): smtp-relay.brevo.com  port 587
#   Mailgun SMTP    : smtp.mailgun.org         port 587
