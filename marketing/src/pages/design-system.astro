---
import '../styles/global.css';
import DesignSystemSidebar from '../components/preview/DesignSystemSidebar.astro';
import PreviewTopNav from '../components/preview/PreviewTopNav.astro';
import DesignTokenPreview from '../components/preview/DesignTokenPreview.astro';
import Alert from '../components/primitives/Alert.astro';
import Badge from '../components/primitives/Badge.astro';
import Button from '../components/primitives/Button.astro';
import Heading from '../components/primitives/Heading.astro';
import Input from '../components/primitives/Input.astro';
import Textarea from '../components/primitives/Textarea.astro';
import { designSystemNavItems } from '../lib/previewNav';

const lbl =
  'mb-4 text-[10px] font-bold uppercase tracking-[0.14em] text-ds-gray';

const card =
  'scroll-mt-28 rounded-card border-[2.5px] border-ds-charcoal bg-ds-white p-6 shadow-ds-md sm:p-7';

const chip =
  'shrink-0 whitespace-nowrap rounded-full border-2 border-ds-charcoal bg-ds-white px-3 py-1.5 text-xs font-semibold text-ds-charcoal hover:bg-ds-offwhite';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design system — componentes</title>
    <meta name="description" content="Grade de referência visual para tokens e componentes do marketing." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@200;300;400;500;600;700;800;900&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[var(--color-surface)] text-ds-charcoal">
    <PreviewTopNav current="design-system" />

    <div class="mx-auto flex w-full max-w-[1200px] gap-0 px-4 pb-16 pt-6 sm:px-6 lg:gap-10 lg:px-8">
      <aside class="hidden w-52 shrink-0 lg:block">
        <div class="sticky top-24 space-y-2">
          <DesignSystemSidebar />
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <nav class="-mx-1 mb-6 flex gap-1 overflow-x-auto px-1 pb-1 lg:hidden" aria-label="Secções">
          {
            designSystemNavItems.map((item) => (
              <a href={`#${item.id}`} class={chip}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <main id="main">
          <section
            id="overview"
            class="scroll-mt-28 mb-10 border-b-[2.5px] border-ds-charcoal pb-8"
          >
            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ds-gray">Dev · visual QA</p>
            <h1 class="mt-2 font-display text-4xl font-black tracking-[var(--ds-tracking-display)] sm:text-5xl">
              Design system
            </h1>
            <p class="mt-3 max-w-2xl text-sm text-ds-gray leading-relaxed">
              Tokens em <code class="rounded bg-ds-offwhite px-1.5 py-0.5 font-mono text-xs">design-tokens.css</code> ·
              Documentação e regras de PR em
              <code class="rounded bg-ds-offwhite px-1.5 py-0.5 font-mono text-xs">docs/marketing/08-design-system.md</code>
              (atualizar preview e doc ao adicionares tokens ou componentes). Secções nesta página — menu lateral (desktop) ou chips
              (mobile).
            </p>
          </section>

          <div class="grid grid-cols-1 gap-3.5 md:grid-cols-12">
            <DesignTokenPreview lbl={lbl} />

            <section id="typography" class={`${card} md:col-span-7`}>
              <h2 class={lbl}>Tipografia</h2>
              <div class="divide-y divide-[#EBEBEB]">
                <div class="flex flex-wrap items-baseline justify-between gap-3 py-3 first:pt-0">
                  <span class="font-display text-4xl font-black tracking-[var(--ds-tracking-display)]">Display</span>
                  <span class="text-[10px] font-medium uppercase tracking-wider text-ds-gray">Epilogue 900</span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-3 py-3">
                  <Heading level={2} class="!text-2xl sm:!text-3xl">Heading 2</Heading>
                  <span class="text-[10px] font-medium uppercase tracking-wider text-ds-gray">Epilogue 700</span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-3 py-3">
                  <Heading level={3}>Section title</Heading>
                  <span class="text-[10px] font-medium uppercase tracking-wider text-ds-gray">Epilogue 600</span>
                </div>
                <div class="flex flex-wrap items-end justify-between gap-3 py-3 last:pb-0">
                  <p class="max-w-md text-sm leading-relaxed text-[#444444]">
                    Texto corrido em Outfit — denso, legível, neutro.
                  </p>
                  <span class="text-[10px] font-medium uppercase tracking-wider text-ds-gray">Outfit 400</span>
                </div>
              </div>
            </section>

            <section id="buttons" class={`${card} md:col-span-4`}>
              <h2 class={lbl}>Botões</h2>
              <div class="flex flex-col gap-2">
                <Button variant="vivid">Vivid · CTA</Button>
                <Button variant="primary">Primary · green</Button>
                <Button variant="dark">Dark · acento</Button>
                <Button variant="secondary">Secondary</Button>
                <Button variant="ghost">Ghost · tracejado</Button>
                <Button href="#">Link button</Button>
              </div>
            </section>

            <section id="shadows" class={`${card} md:col-span-4`}>
              <h2 class={lbl}>Sombras (hard offset)</h2>
              <div class="grid grid-cols-3 gap-2.5">
                <div>
                  <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-ds-gray">3×3</p>
                  <div
                    class="flex h-14 items-center justify-center rounded-md border-[2.5px] border-ds-charcoal bg-ds-white text-[10px] font-bold uppercase tracking-wide shadow-ds-sm"
                  >
                    SM
                  </div>
                </div>
                <div>
                  <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-ds-gray">5×5</p>
                  <div
                    class="flex h-14 items-center justify-center rounded-md border-[2.5px] border-ds-charcoal bg-ds-white text-[10px] font-bold uppercase tracking-wide shadow-ds-md"
                  >
                    MD
                  </div>
                </div>
                <div>
                  <p class="mb-2 text-[10px] font-bold uppercase tracking-wider text-ds-gray">Acento</p>
                  <div
                    class="flex h-14 items-center justify-center rounded-md border-[2.5px] border-ds-charcoal bg-ds-charcoal text-[10px] font-bold uppercase tracking-wide text-ds-offwhite shadow-ds-accent"
                  >
                    ·
                  </div>
                </div>
              </div>
              <p class="mt-4 border-t border-[#EBEBEB] pt-3 text-xs leading-relaxed text-ds-gray">
                Sem blur — sombra sólida alinhada ao grid.
              </p>
            </section>

            <section id="badges" class={`${card} md:col-span-4`}>
              <h2 class={lbl}>Badges e raios</h2>
              <div class="flex flex-wrap gap-2">
                <Badge variant="vivid">Ativo</Badge>
                <Badge variant="dark">Mercado</Badge>
                <Badge variant="lime">OK</Badge>
                <Badge variant="white">Análise</Badge>
                <Badge variant="outline">Outline</Badge>
              </div>
              <p class="mt-6 text-[10px] font-bold uppercase tracking-[0.14em] text-ds-gray">Raio (referência)</p>
              <div class="mt-2 grid grid-cols-4 gap-2">
                <div
                  class="flex h-12 items-center justify-center rounded-[6px] border-[2.5px] border-ds-charcoal bg-ds-offwhite text-[10px] font-bold uppercase text-ds-gray"
                >
                  6
                </div>
                <div
                  class="flex h-12 items-center justify-center rounded-[12px] border-[2.5px] border-ds-charcoal bg-ds-offwhite text-[10px] font-bold uppercase text-ds-gray"
                >
                  12
                </div>
                <div
                  class="flex h-12 items-center justify-center rounded-[18px] border-[2.5px] border-ds-charcoal bg-ds-offwhite text-[10px] font-bold uppercase text-ds-gray"
                >
                  18
                </div>
                <div
                  class="flex h-12 items-center justify-center rounded-pill border-[2.5px] border-ds-charcoal bg-ds-offwhite text-[10px] font-bold uppercase text-ds-gray"
                >
                  pill
                </div>
              </div>
            </section>

            <section id="fields" class={`${card} md:col-span-6`}>
              <h2 class={lbl}>Campos</h2>
              <div class="space-y-4">
                <Input id="ds-demo-name" name="demo_name" label="Nome" placeholder="Seu nome" />
                <Input
                  id="ds-demo-email"
                  name="demo_email"
                  type="email"
                  label="E-mail"
                  required
                  placeholder="voce@exemplo.com"
                  autocomplete="email"
                />
                <Textarea id="ds-demo-msg" name="demo_msg" label="Mensagem" placeholder="Opcional" rows={3} />
              </div>
            </section>

            <section id="alerts" class={`${card} md:col-span-6`}>
              <h2 class={lbl}>Alertas semânticos</h2>
              <div class="flex flex-col gap-2.5">
                <Alert tone="success" title="Contrato ativado">
                  Economia em vigor a partir de hoje.
                </Alert>
                <Alert tone="warning" title="Consumo acima da média">
                  Revise equipamentos de maior consumo.
                </Alert>
                <Alert tone="error" title="Falha no processamento">
                  Verifique os dados de pagamento.
                </Alert>
                <Alert tone="info" title="Nova tarifa disponível">
                  Acesse o simulador para comparar.
                </Alert>
              </div>
            </section>

            <section
              id="content-overrides"
              class="scroll-mt-28 rounded-card border-[2.5px] border-ds-charcoal bg-ds-offwhite p-6 shadow-ds-sm sm:p-7 md:col-span-12"
            >
              <h2 class={lbl}>Conteúdo · token overrides</h2>
              <p class="max-w-3xl text-sm leading-relaxed text-ds-gray">
                Páginas MDX podem sobrescrever um subconjunto de variáveis (<code class="font-mono text-ds-charcoal">--color-cta-bg</code> etc.) via
                <code class="font-mono text-ds-charcoal">tokenOverrides</code> — ver <code class="font-mono text-ds-charcoal">src/lib/tokens.ts</code> e
                <code class="font-mono text-ds-charcoal">docs/marketing/02-content-model.md</code>.
              </p>
            </section>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
