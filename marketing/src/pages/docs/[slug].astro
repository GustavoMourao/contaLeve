---
import { getCollection, render } from 'astro:content';

import DocsLayout from '../../components/layouts/DocsLayout.astro';
import { handbookNavTitle } from '../../lib/handbookNav';

export async function getStaticPaths() {
  const handbook = await getCollection('handbook');
  return handbook.map((entry) => {
    const slug = entry.id.replace(/\.md$/i, '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/docs');

const handbook = await getCollection('handbook');
const entry = handbook.find((e) => e.id.replace(/\.md$/i, '') === slug);
if (!entry) return Astro.redirect('/docs');

const { Content } = await render(entry);
const title = entry.data.title ?? handbookNavTitle(slug);
---

<DocsLayout title={title} currentSlug={entry.id.replace(/\.md$/i, '')}>
  <article class="docs-markdown max-w-3xl">
    <Content />
  </article>
</DocsLayout>
