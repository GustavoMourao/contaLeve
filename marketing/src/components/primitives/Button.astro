---
export type ButtonVariant = 'primary' | 'vivid' | 'dark' | 'secondary' | 'ghost';

interface Props {
  href?: string;
  variant?: ButtonVariant;
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

const base =
  'inline-flex w-full items-center justify-center gap-2 rounded-md border-[2.5px] border-ds-charcoal px-5 py-2.5 text-sm font-semibold transition-opacity duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ds-green focus-visible:ring-offset-2 focus-visible:ring-offset-ds-white sm:w-auto';

const byVariant: Record<ButtonVariant, string> = {
  primary: 'bg-ds-green text-ds-charcoal shadow-ds-sm hover:opacity-90',
  vivid: 'bg-ds-green-vivid text-ds-charcoal shadow-ds-sm hover:opacity-90',
  dark: 'bg-ds-charcoal text-ds-offwhite shadow-[3px_3px_0_var(--ds-green)] hover:opacity-95',
  secondary: 'bg-ds-white text-ds-charcoal shadow-ds-sm hover:opacity-90',
  ghost: 'border-dashed bg-transparent text-ds-charcoal shadow-none hover:bg-ds-offwhite',
};

const classes = `${base} ${byVariant[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
