---
export type AlertTone = 'success' | 'warning' | 'error' | 'info';

interface Props {
  tone: AlertTone;
  title: string;
  class?: string;
}

const { tone, title, class: className = '' } = Astro.props;

const role = tone === 'error' ? 'alert' : 'status';

const toneBorder: Record<AlertTone, string> = {
  success: 'border-ds-success shadow-[4px_4px_0_var(--ds-sem-success)]',
  warning: 'border-ds-warning shadow-[4px_4px_0_var(--ds-sem-warning)]',
  error: 'border-ds-error shadow-[4px_4px_0_var(--ds-sem-error)]',
  info: 'border-ds-info shadow-[4px_4px_0_var(--ds-sem-info)]',
};

const iconStroke: Record<AlertTone, string> = {
  success: '#3d7a00',
  warning: '#7a5f00',
  error: 'var(--ds-sem-error)',
  info: 'var(--ds-sem-info)',
};

const stroke = iconStroke[tone];
---
<div
  class={`flex gap-3 rounded-lg border-[2.5px] bg-ds-white p-4 ${toneBorder[tone]} ${className}`}
  role={role}
>
  <span class="mt-0.5 shrink-0" aria-hidden="true">
    {tone === 'success' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    )}
    {tone === 'warning' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
    )}
    {tone === 'error' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="15" y1="9" x2="9" y2="15" />
        <line x1="9" y1="9" x2="15" y2="15" />
      </svg>
    )}
    {tone === 'info' && (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
    )}
  </span>
  <div>
    <p class="text-[13px] font-bold leading-snug text-ds-charcoal">{title}</p>
    <div class="mt-1 text-xs leading-snug text-ds-gray">
      <slot />
    </div>
  </div>
</div>
