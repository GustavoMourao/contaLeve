---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';

interface Props {
  heading?: string;
  items: Array<{ question: string; answer: string }>;
}
const { heading, items } = Astro.props;
---
<Section>
  <Container class="max-w-3xl">
    {heading && (
      <Heading level={2} class="text-center mb-12">{heading}</Heading>
    )}
    <ul class="divide-y divide-ds-charcoal border-y-[2.5px] border-ds-charcoal">
      {items.map((item) => (
        <li>
          <details class="group py-5">
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 list-none text-left text-lg font-semibold text-ds-charcoal focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ds-green focus-visible:ring-offset-2 focus-visible:ring-offset-ds-white"
            >
              <span>{item.question}</span>
              <svg
                aria-hidden="true"
                class="h-5 w-5 flex-shrink-0 text-ds-gray transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.1l3.71-3.87a.75.75 0 111.08 1.04l-4.25 4.43a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="mt-3 text-ds-gray leading-relaxed">
              {item.answer}
            </p>
          </details>
        </li>
      ))}
    </ul>
  </Container>
</Section>

<style>
  /* Hide the default disclosure marker across browsers; the chevron above is the visual cue. */
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
</style>
