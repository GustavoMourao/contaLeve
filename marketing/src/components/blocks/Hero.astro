---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Button from '../primitives/Button.astro';

interface Props {
  headline: string;
  subhead?: string;
  cta: { label: string; href: string };
}
const { headline, subhead, cta } = Astro.props;
---
<Section>
  <Container class="text-center">
    <Heading level={1} class="text-balance">{headline}</Heading>
    {subhead && (
      <p class="mt-6 text-lg text-[var(--color-muted)] max-w-2xl mx-auto text-balance">
        {subhead}
      </p>
    )}
    <div class="mt-10">
      <Button href={cta.href} variant="primary">{cta.label}</Button>
    </div>
  </Container>
</Section>
