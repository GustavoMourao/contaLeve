---
import { designSystemNavItems } from '../../lib/previewNav';
---

<nav aria-label="Secções do design system" class="text-sm">
  <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.14em] text-ds-gray">Nesta página</p>
  <ul class="space-y-0.5 border-t-[2.5px] border-ds-charcoal pt-3">
    {
      designSystemNavItems.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            class="block rounded-md px-2 py-1.5 font-medium text-ds-charcoal transition-colors hover:bg-ds-white"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
